# ──────────────────────────────────────────────────────────
# TEOS Sentinel Shield — Environment Variables
# Copy this file to .env and fill in your values.
#   cp .env.example .env
# ──────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────
PORT=3000
# Server port. Railway sets this via PORT env var automatically.

NODE_ENV=development
# Runtime mode: "development" | "production" | "test"
# Controls error verbosity, CORS behavior, and log formatting.
# Railway: set to "production".

LOG_LEVEL=info
# Pino log level: "trace" | "debug" | "info" | "warn" | "error" | "fatal"
# pino-pretty formatting auto-enables when NODE_ENV != production and stdout is TTY.

# ── CORS ──────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000
# Comma-separated list of allowed CORS origins.
# Examples:
#   ALLOWED_ORIGINS=http://localhost:3000,https://sentinel.teosegypt.com
# Railway: set to https://sentinel.teosegypt.com or your dashboard domain.

CORS_ORIGIN=http://localhost:3000
# Fallback CORS origin used by ws-server entrypoint.
# Kept separate from ALLOWED_ORIGINS for backward compatibility.
# Railway: same value as ALLOWED_ORIGINS.

# ── Authentication ────────────────────────────────────────
TEOS_API_KEYS=your-api-key-here
# Comma-separated list of API keys accepted for shield API authentication.
# At least one key is required for production.
# Railway: generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Then set: TEOS_API_KEYS=<generated-key>

# ── Event Store ───────────────────────────────────────────
MAX_EVENTS=500
# Maximum number of scan events kept in the in-memory/Redis store.
# Older events are pruned when this limit is exceeded.

# ── Payload Limits ────────────────────────────────────────
MAX_PAYLOAD_KB=64
# Maximum request body size in kilobytes.
# Scan payloads larger than this are rejected with 413.

# ── Rate Limiting ─────────────────────────────────────────
RATE_LIMIT_WIN=60
# Rate limit time window in seconds.

RATE_LIMIT_MAX=120
# Maximum requests allowed per window per IP.

TRUST_PROXY=1
# Number of reverse proxy hops to trust for IP extraction.
# Railway: set to 1 (behind Railway router).
# Local: set to 0 if not behind a proxy.

# ── WebSocket (optional) ──────────────────────────────────
WS_POLL_MS=5000
# WebSocket event poll interval in milliseconds.
# How often the WS server checks for new events to broadcast.

WS_HEARTBEAT_MS=30000
# WebSocket heartbeat interval in milliseconds.
# Connections silent longer than this are terminated.

MAX_WS_PEERS=100
# Maximum simultaneous WebSocket connections.

# ── Redis (optional — falls back to in-memory store) ──────
# REDIS_URL=redis://localhost:6379
# Redis connection string. If unset, events are stored in memory.
# Memory store resets on deploy — suitable for alpha/development.
# Railway: use Railway Redis plugin and set REDIS_URL to the provided connection string.
# Uncomment and set for persistent event storage:

# REDIS_URL=redis://default:password@host:port

# ── Deploy Tracking (optional) ────────────────────────────
# RAILWAY_GIT_COMMIT_SHA=
# Set automatically by Railway. Logged in /health endpoint for deploy tracking.

# GIT_COMMIT_SHA=
# Fallback for non-Railway deploys. Set in CI/CD pipeline.

# ── CLI / CI Scripts (optional) ───────────────────────────
# TEOS_API_URL=https://sentinel.teosegypt.com
# Base URL for the shield API. Used by scripts/sentinel.js and cli/teos.js.
# Defaults to production Railway URL.

# TEOS_API_KEY=
# API key for CLI/CI script authentication.
# Must match a key in TEOS_API_KEYS.

# TEOS_LOG_DIR=
# Directory for CLI enforcement logs. Defaults to current working directory.

# ── AI Feedback Loop (optional) ───────────────────────────
# ANTHROPIC_API_KEY=sk-ant-...
# Anthropic API key for the AI-powered feedback loop in core-engine/.
# Only needed if the feedback engine is enabled.

# ── Next.js Landing Page (optional — teos-landing/) ───────
# NEXT_PUBLIC_SHIELD_API_URL=http://localhost:3000
# Public API URL for the InteractiveProof demo component.
# Railway: set to https://teos-sentinel-shield-production-ef7a.up.railway.app

# NEXT_PUBLIC_DEMO_API_KEY=
# Public demo API key for the InteractiveProof demo component.
# Must match a key in TEOS_API_KEYS. Leave empty to disable demo mode.

# NEXT_PUBLIC_ALPHA_ACTIVATION_SECRET=
# Public alpha activation secret reference for the dashboard deep-link display.
# Optional — shown in dashboard UI for tester onboarding reference.

# ── Supabase (DEPRECATED — no longer used) ─────────────────
# Supabase was removed in Session 14. These vars are referenced in config.cjs
# validation but are not required for operation. Left for backward compatibility.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIs...
