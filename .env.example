# TEOS Sentinel Shield — Environment Variables
# Copy to .env and fill in real values

# ── Upstash Redis (required for rate limiting + caching) ──
UPSTASH_REDIS_REST_URL=https://your-project.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_token_here

# ── Supabase Postgres (required for persistent audit logs) ──
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ── API Keys (comma-separated, tier encoded in key name) ──
# Tier suffixes: -free, -starter, -pro, -enterprise
# Examples: sk-prod-pro-abc123, sk-dev-free-xyz789
TEOS_API_KEYS=dev-key-free-001

# ── Public site + API ──
CORE_ENGINE_API_URL=https://agent-code-risk-mcp-production-b97d.up.railway.app
TEOS_API_URL=https://sentinel.teosegypt.com
# TEOS_WS_REQUIRE_AUTH=1

# ── Rate Limiting (overrides) ──
# RATE_LIMIT_WIN=60
# RATE_LIMIT_MAX=120
# DISABLE_RATE_LIMIT=true

# ── Server ──
# PORT=3000
# NODE_ENV=production
# MAX_EVENTS=500
# MAX_PAYLOAD_KB=64

# ── Dodo Payments (billing + subscriptions) ──
# Get these from: https://dashboard.dodopayments.com/developer
DODO_PAYMENTS_API_KEY=your_api_key_here
DODO_PAYMENTS_WEBHOOK_KEY=your_webhook_secret_here
DODO_PAYMENTS_ENVIRONMENT=test_mode
DODO_RETURN_URL=https://teos-landing-seven.vercel.app

# ── Dodo Cloud Products ──
DODO_PRODUCT_FREE_MONTHLY=
DODO_PRODUCT_STARTER_SETUP=prod_xxx
DODO_PRODUCT_STARTER_MONTHLY=prod_xxx
DODO_PRODUCT_STARTER_ANNUAL=prod_xxx
DODO_PRODUCT_TEAM_SETUP=prod_xxx
DODO_PRODUCT_TEAM_MONTHLY=prod_xxx
DODO_PRODUCT_TEAM_ANNUAL=prod_xxx
DODO_PRODUCT_ENTERPRISE_SETUP=prod_xxx
DODO_PRODUCT_ENTERPRISE_MONTHLY=prod_xxx
DODO_PRODUCT_ENTERPRISE_ANNUAL=prod_xxx

# ── Dodo Sovereign Products ──
DODO_PRODUCT_SOVEREIGN_BASE=prod_xxx
DODO_PRODUCT_SOVEREIGN_ADDITIONAL_SITE=prod_xxx
DODO_PRODUCT_SOVEREIGN_CUSTOM_RULES=prod_xxx
DODO_PRODUCT_SOVEREIGN_ONSITE_DEPLOYMENT=prod_xxx
DODO_PRODUCT_SOVEREIGN_SUPPORT_SLA=prod_xxx
DODO_PRODUCT_SOVEREIGN_SOURCE_ESCROW=prod_xxx

# ── CORS ──
# CORS_ORIGIN=https://teos-landing-seven.vercel.app
