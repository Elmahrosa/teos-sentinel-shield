{
  "version": 2,
  "builds": [
    { "src": "server/api.js", "use": "@vercel/node" },
    { "src": "public/**/*", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/scan",           "dest": "server/api.js" },
    { "src": "/stats",          "dest": "server/api.js" },
    { "src": "/events",         "dest": "server/api.js" },
    { "src": "/events/stream",  "dest": "server/api.js" },
    { "src": "/audit",          "dest": "server/api.js" },
    { "src": "/audit/summary",  "dest": "server/api.js" },
    { "src": "/health",         "dest": "server/api.js" },
    { "src": "/enforce",        "dest": "server/api.js" },
    { "src": "/ledger/verify",  "dest": "server/api.js" },
    { "src": "/metrics",        "dest": "server/api.js" },
    { "src": "/webhook/dodo",   "dest": "server/api.js" },
    { "src": "/billing/checkout", "dest": "server/api.js" },
    { "src": "/billing/usage",   "dest": "server/api.js" },
    { "src": "/billing/pricing", "dest": "server/api.js" },
    { "src": "/openapi-spec\\.yaml", "dest": "docs/openapi-spec.yaml" },
    { "src": "/openapi\\.yaml",  "dest": "docs/openapi-spec.yaml" },
    { "src": "/rules\\.json",    "dest": "public/rules.json" },
    { "src": "/test-cases\\.json","dest": "public/test-cases.json" },
    { "src": "/audit-example\\.json","dest": "public/audit-example.json" },
    { "src": "/sentinel",       "dest": "public/sentinel.html" },
    { "src": "/sentinel\\.html","dest": "public/sentinel.html" },
    { "src": "/",               "dest": "public/index.html" },
    { "src": "/(.*)",           "dest": "public/$1" }
  ]
}
