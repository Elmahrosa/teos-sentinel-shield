# TEOS Sentinel Shield v4.0.0 GA — Hostinger
# COMPLETE SITE REPLACE — force HTTPS + security headers

RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Prefer index.html
DirectoryIndex index.html

# ── API reverse proxy → proxy.php → Railway backend ──────────────
# Lets sentinel.teosegypt.com serve /scan /stats /events /health /api/*
# on the same origin. Only whitelisted API paths are proxied.
# NOTE: /ws (WebSocket) is NOT proxied — shared hosting cannot tunnel it;
# frontends connect the live feed directly to the Railway WebSocket.
RewriteRule ^(scan|stats|events|health|live|ready|fullreport|ingest|engines)(/.*)?$ proxy.php [L,QSA]
RewriteRule ^api/(rules|version|audit)(/.*)?$ proxy.php [L,QSA]

# Cache static assets
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

# Block env / secrets if ever uploaded by mistake
<FilesMatch "^\.env|FOUNDER|credentials">
  Require all denied
</FilesMatch>
