# TEOS Superintelligence — Environment Configuration

# === Required ===
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
API_KEY=replace-with-secure-api-key-for-token-issuance
JWT_SECRET=replace-with-at-least-32-characters-strong-random-secret
ENV=development

# === Redis ===
REDIS_URL=redis://localhost:6379

# === PostgreSQL ===
DATABASE_URL=postgresql://teos:teos@localhost:5432/teos

# === Sentinel Shield ===
SENTINEL_URL=http://sentinel:8001

# === MCP Servers (External URLs) ===
MCP_CODE_RISK_URL=http://localhost:8002/mcp
MCP_CODE_RISK_TOKEN=
MCP_DUE_DILIGENCE_URL=http://localhost:8003/mcp
MCP_DUE_DILIGENCE_TOKEN=

# === RAG Ingestion ===
TEOS_WHITELISTED_REPOS=teos-platform,teos-sentinel-stack,Teos-Integration
TEOS_DEPRECATED_REPOS=teos-bankchain,UCH-Backend
TEOS_RAG_ALLOWED_DIRS=/home/user/projects,/data/repos
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# === Admin Control Plane ===
EMERGENCY_HALT_KEY=replace-with-secure-random-key
ADMIN_VETO_KEY=replace-with-secure-random-key
GITHUB_PAT=ghp_xxxxxxxxxxxx

# === Optional ===

# RS256 keys (if not set, falls back to HS256 using JWT_SECRET)
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# Rate limiting (requests per hour)
RATE_LIMIT_RPH=1000

# ChromaDB path for RAG vector store
CHROMA_PATH=/data/chroma

# Logging
LOG_LEVEL=INFO

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# Cost tracking
ENABLE_COST_TRACKING=true
