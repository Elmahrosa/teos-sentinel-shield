  "components": {
    "schemas": {
      "AuthTokenRequest": {
        "properties": {
          "username": {
            "type": "string",
            "title": "Username",
            "description": "Elmahrosa username"
          },
          "api_key": {
            "type": "string",
            "title": "Api Key",
            "description": "API key for authentication"
          }
        },
        "type": "object",
        "required": [
          "username",
          "api_key"
        ],
        "title": "AuthTokenRequest"
      },
      "Body_rag_ingest_rag_ingest_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_rag_ingest_rag_ingest_post"
      },
      "Body_run_tool_tools_run_post": {
        "properties": {
          "tool_name": {
            "type": "string",
            "title": "Tool Name"
          }
        },
        "type": "object",
        "required": [
          "tool_name"
        ],
        "title": "Body_run_tool_tools_run_post"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "version": {
            "type": "string",
            "title": "Version"
          },
          "sentinel": {
            "type": "string",
            "title": "Sentinel"
          },
          "redis": {
            "type": "string",
            "title": "Redis"
          },
          "db": {
            "type": "string",
            "title": "Db"
          }
        },
        "type": "object",
        "required": [
          "status",
          "version",
          "sentinel",
          "redis",
          "db"
        ],
        "title": "HealthResponse"
      },
      "QueryRequest": {
        "properties": {
          "query": {
            "type": "string",
            "title": "Query",
            "description": "User input query"
          },
          "session_id": {
            "type": "string",
            "title": "Session Id",
            "description": "Unique session identifier"
          },
          "agent": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Agent",
            "description": "Agent name to route to"
          },
          "images": {
            "anyOf": [
              {
                "items": {
                  "additionalProperties": true,
                  "type": "object"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Images",
            "description": "Base64-encoded images (multi-modal)"
          },
          "search_rag": {
            "type": "boolean",
            "title": "Search Rag",
            "description": "Whether to search RAG vector store",
            "default": false
          },
          "callback_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
