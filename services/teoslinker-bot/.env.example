# TEOS Linker Bot — Environment Example
# Copy to .env and fill in real values

# ── Telegram ──
# MUST SET — get from @BotFather on Telegram
BOT_TOKEN=changeme-your-bot-token-from-botfather

# ── HTTP Server ──
PORT=8082
NODE_ENV=production
LOG_LEVEL=info

# ── Upstream Services ──
# ACTIVATION_API — REQUIRED (credits, tiers, audit). The bot degrades without it.
ACTIVATION_API=http://activation-service:8080
# MCP_API — OPTIONAL. Powers /deps, /ci, /solanatoken, /diligence, /fullreport and Claude
# tool interception. Core /scan works without it (in-process rules + cloud Sentinel).
# MCP_API=http://risk-engine:8090
# MCP_ENGINE_URL=http://risk-engine:8090

# ── Sentinel Cloud API (optional) ──
# Adds the cloud rules engine to /scan and live engine metadata to /status.
# SENTINEL_URL=https://sentinel.teosegypt.com
# SENTINEL_API_KEY=your-sentinel-api-key

# ── AI Providers (optional) ──
# Groq — free models used by /llama3, /qwen, /openai and /model.
# GROQ_API_KEY=your-groq-api-key
# Anthropic — enables /claude and the claude models in /model.
# ANTHROPIC_API_KEY=your-anthropic-api-key

# ── Authentication ──
# MCP_AUTH_TOKEN=your-mcp-auth-token
# ACTIVATION_AUTH_TOKEN=your-activation-auth-token

# ── Redis (Upstash for shared event store) ──
# UPSTASH_REDIS_REST_URL=https://your-project.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your_token_here

# ── Dodo Payments Product IDs ──
DODO_PRODUCT_FREE=pdt_0NiubmCSx2SjBo3jWNyGO
DODO_PRODUCT_STARTER_MONTHLY=pdt_0NiubmCxvCi9MJbVfnJAT
DODO_PRODUCT_STARTER_ANNUAL=pdt_0NiubmDStYOWzNVUkcFC8
DODO_PRODUCT_TEAM_MONTHLY=pdt_0NiubmE6vERG5onrMT21p
DODO_PRODUCT_TEAM_ANNUAL=pdt_0NiubmEpW4Oi0kzhoFZIC
DODO_PRODUCT_TEAM_SETUP=pdt_0NiubvVZXt5nf0baIbV1x
DODO_ADDON_TEAM_SETUP=adn_0NiubmC4mFj2iGnWfiGvH

# ── Credits ──
FREE_CREDITS=5

# ── Admin ──
# ADMIN_IDS=123456789,987654321

# ── Security (Helmet + Rate Limit + CORS) ──
ALLOWED_ORIGINS=http://localhost:3000,https://app.teos.ai
TRUST_PROXY=1
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
REQUEST_SIZE_LIMIT=10kb

# ── Webhook Mode (optional — use instead of polling for production) ──
# Set to "true" to use webhooks instead of long polling
# BOT_USE_WEBHOOK=false
# Your public HTTPS URL where Telegram sends updates
# BOT_WEBHOOK_URL=https://your-domain.com
# Optional secret token to verify webhook requests
# BOT_WEBHOOK_SECRET=
