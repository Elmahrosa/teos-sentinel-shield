# TEOS Activation Service — Environment Example
# Copy to .env and fill in real values

# ── Server ──
PORT=8080
NODE_ENV=production
LOG_LEVEL=info

# ── Dodo Payments Webhook ──
# MUST SET — generate with: openssl rand -hex 32
DODO_WEBHOOK_SECRET=changeme-dodo-webhook-secret-32-bytes-hex

# ── Admin ──
# MUST SET — strong random string, min 16 chars
ADMIN_SECRET=changeme-admin-secret-min-16-chars

# ── Service Auth Token ──
# Shared secret for inter-service calls (teoslinker-bot, sentinel-shield -> activation)
# Leave empty to allow unauthenticated access (dev only)
ACTIVATION_AUTH_TOKEN=changeme-service-auth-token

# ── Security (Helmet + Rate Limit + CORS) ──
ALLOWED_ORIGINS=http://localhost:3000,https://app.teos.ai
TRUST_PROXY=1
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
REQUEST_SIZE_LIMIT=10kb
